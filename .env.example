# Générer une clé avec : openssl rand -base64 32
# Secret : uniquement dans les variables d’environnement Dokploy, jamais dans le dépôt.
SESSION_SECRET=
# URL HTTPS du flux XML CELCAT (valeur par défaut dans server/lib/celcat-auth.js si absente).
# Hôtes autorisés (redirection CAS comprise) dérivés de cette URL : son hôte exact, son domaine parent et les sous-domaines, HTTPS uniquement.
CELCAT_XML_URL=
# Plafond optionnel des réponses amont en octets (défaut 5 Mo) et des occurrences (défaut 20000).
CELCAT_MAX_BYTES=
CELCAT_MAX_COURSES=
# Nombre maximal de sessions actives en mémoire (défaut 5000).
SESSION_MAX_ACTIVE=
PORT=3000
# Requis en production ; laisser absent pour le développement local HTTP.
# APP_ORIGIN=https://edt.theo-birost.fr
# IP ou CIDR exacts du proxy Traefik. Vide = ne pas faire confiance aux en-têtes proxy.
TRUSTED_PROXIES=
LEGAL_PUBLISHER="Théo Birost — Birost Web"
LEGAL_STATUS="Entrepreneur individuel (EI)"
LEGAL_ADDRESS="6 rue Georges Guynemer, 10450 Bréviandes, France"
LEGAL_CONTACT=contact@theo-birost.fr
LEGAL_DIRECTOR="Théo Birost"
LEGAL_REGISTRATION="SIREN 108 892 993 — SIRET 108 892 993 00016"
LEGAL_VAT="Non applicable, article 293 B du CGI — franchise en base de TVA"
LEGAL_CAPITAL="Non applicable — entrepreneur individuel"
# Durée (jours) affichée dans la politique de confidentialité (défaut 30). Déclaration seulement : l’application ne supprime aucun journal.
LOG_RETENTION_DAYS="3"
